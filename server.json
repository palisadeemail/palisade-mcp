{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "email.palisade/palisade",
  "description": "Monitor and manage email authentication (SPF, DKIM, DMARC, MTA-STS, BIMI) for your domains.",
  "repository": {
    "url": "https://github.com/palisadeemail/palisade-mcp",
    "source": "github"
  },
  "version": "1.0.3",
  "websiteUrl": "https://www.palisade.email/mcp",
  "icons": [
    {
      "src": "https://app.palisade.email/logo512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    },
    {
      "src": "https://app.palisade.email/logo192.png",
      "mimeType": "image/png",
      "sizes": ["192x192"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@palisadeemail/mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Palisade API key. Create one at https://app.palisade.email under Settings > API keys.",
          "isRequired": true,
          "isSecret": true,
          "name": "PALISADE_API_KEY"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.palisade.email/mcp"
    }
  ]
}
